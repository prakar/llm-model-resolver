{
  "schemaVersion": 1,
  "description": "Conformance vectors for llm-model-resolver. Each case feeds a raw provider model-list response through the full pipeline (parse, price, filter, prefer, order, choose) under an inline config. Any port (e.g. Kotlin) must reproduce `expect`. The configs are self-contained copies, independent of the shipped profiles, so editing a price table never breaks these.",
  "endpoints": {
    "xai": "https://api.x.ai/v1/language-models",
    "anthropic": "https://api.anthropic.com/v1/models",
    "gemini": "https://generativelanguage.googleapis.com/v1beta/models"
  },
  "configs": {
    "econ": {
      "global": {
        "timeoutMs": 300000,
        "cooldownMs": 60000,
        "order": "cheapest"
      },
      "providers": {
        "xai": {
          "include": "^grok-",
          "exclude": "image|imagine|video|code-fast",
          "prefer": "non-?reasoning",
          "fallback": "grok-4.3"
        },
        "anthropic": {
          "include": "^claude-",
          "exclude": "instant|mini|fable|mythos",
          "fallback": "claude-haiku-4-5",
          "knownPrices": {
            "source": "maintained",
            "updated": "2026-01-01",
            "models": {
              "claude-3-haiku": {
                "input": 0.25,
                "output": 1.25
              },
              "claude-haiku-4": {
                "input": 1,
                "output": 5
              },
              "claude-haiku-5": {
                "input": 0.1,
                "output": 0.5
              },
              "claude-sonnet-5": {
                "input": 3,
                "output": 15
              },
              "claude-opus-5": {
                "input": 15,
                "output": 75
              }
            }
          }
        },
        "gemini": {
          "include": "gemini-",
          "exclude": "lite|embedding|aqa|imagen|veo|tts|live|image|audio|latest",
          "fallback": "gemini-flash-latest",
          "knownPrices": {
            "source": "maintained",
            "updated": "2026-01-01",
            "models": {
              "gemini-2.5-flash": {
                "input": 0.075,
                "output": 0.3
              },
              "gemini-3.6-flash": {
                "input": 0.75,
                "output": 3.75
              },
              "gemini-2.5-pro": {
                "input": 1.25,
                "output": 5
              }
            }
          }
        },
        "openrouter": {
          "fallback": "openrouter/free"
        }
      }
    },
    "flag": {
      "global": {
        "timeoutMs": 600000,
        "cooldownMs": 60000,
        "order": "newest"
      },
      "providers": {
        "xai": {
          "include": "^grok-",
          "exclude": "non-?reasoning|fast|mini|lite|code-fast|image|imagine|video",
          "fallback": "grok-4"
        },
        "anthropic": {
          "include": "^claude-",
          "exclude": "haiku|instant|mini",
          "fallback": "claude-sonnet-5"
        },
        "gemini": {
          "include": "gemini-",
          "exclude": "flash|lite|embedding|aqa|imagen|veo|tts|live|image|audio",
          "fallback": "gemini-flash-latest"
        },
        "openrouter": {
          "fallback": "openrouter/free"
        }
      }
    }
  },
  "cases": [
    {
      "name": "anthropic economy: cheapest priced wins, fable excluded, unpriced ranked last",
      "config": "econ",
      "provider": "anthropic",
      "response": {
        "data": [
          {
            "id": "claude-opus-5-20260301",
            "created_at": "2026-03-01T00:00:00Z",
            "type": "model"
          },
          {
            "id": "claude-sonnet-5-20260301",
            "created_at": "2026-03-01T00:00:00Z",
            "type": "model"
          },
          {
            "id": "claude-haiku-4-5-20251001",
            "created_at": "2025-10-01T00:00:00Z",
            "type": "model"
          },
          {
            "id": "claude-haiku-5-5-20261007",
            "created_at": "2026-10-07T00:00:00Z",
            "type": "model"
          },
          {
            "id": "claude-3-haiku-20240307",
            "created_at": "2024-03-07T00:00:00Z",
            "type": "model"
          },
          {
            "id": "claude-fable-5",
            "created_at": "2026-06-09T00:00:00Z",
            "type": "model"
          },
          {
            "id": "claude-newthing-9",
            "created_at": "2026-11-01T00:00:00Z",
            "type": "model"
          }
        ]
      },
      "expect": {
        "id": "claude-haiku-5-5-20261007",
        "source": "live",
        "tier": 1,
        "orderedBy": "cheapest",
        "ranked": [
          "claude-haiku-5-5-20261007",
          "claude-3-haiku-20240307",
          "claude-haiku-4-5-20251001"
        ]
      }
    },
    {
